# Backend endpoint that returns a team recommendation JSON (supports placeholders).
# Example (direct to backend):
# VITE_FPL_TEAM_RECOMMENDATION_URL="http://127.0.0.1:8001/recommendations?entry_id={entry_id}&event_id={event_id}&horizon_gws={horizon_gws}"
#
# Local dev (via Vite proxy in `vite.config.ts`, avoids CORS):
# VITE_FPL_TEAM_RECOMMENDATION_URL="/recommendations?entry_id={entry_id}&event_id={event_id}&horizon_gws={horizon_gws}&include_transfers={include_transfers}"
VITE_FPL_TEAM_RECOMMENDATION_URL="/recommendations?entry_id={entry_id}&event_id={event_id}&horizon_gws={horizon_gws}&include_transfers={include_transfers}"

# Initial squad endpoint (shown on pitch before you click Recommend).
# Local dev (via Vite proxy in `vite.config.ts`, avoids CORS):
VITE_FPL_SQUAD_URL="/squad?entry_id={entry_id}&event_id={event_id}"

# Fixtures endpoint (used to show opponent + fixture difficulty on the pitch).
# Expected response: array (or { fixtures: [...] }) of { team_short, opponent_short, difficulty, is_home }.
VITE_FPL_FIXTURES_URL="/fixtures?event_id={event_id}"

# Fixtures endpoint (for opponent + difficulty on the pitch).
# Expected response shape:
# - Array of { team_short, opponent_short, difficulty?, is_home? }
# - OR { fixtures: [...] }
VITE_FPL_FIXTURES_URL="/fixtures?event_id={event_id}"
